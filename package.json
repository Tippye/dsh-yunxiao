{
  "name": "@local/dsh-yunxiao",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read and write Alibaba Cloud Yunxiao (云效) from DeepSeek Harness: a sidebar panel plus agent tools for work items, repositories, merge requests and pipelines.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "alibabacloud-devops-mcp-server": "0.3.69"
  }
}
